# Backend production environment
NODE_ENV=production
PORT=7126

# Bind to loopback only — Nginx reverse-proxies to this port, it must never
# be reachable directly from outside the server.
HOST=127.0.0.1

# Local MongoDB on VPS (dedicated app user, not the Mongo superadmin)
MONGODB_URI=mongodb://127.0.0.1:27017/bus-system
DB_NAME=bus-system

# Security
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRATION=7d

# CORS: comma-separated allowed origins.
CORS_ORIGIN=http://localhost:3000

# Uploads folder. On a host with an ephemeral disk this directory is wiped
# when the process restarts.
UPLOAD_DIR=./uploads

# Mail settings (required for verification-code and password-reset emails).
# Uses Gmail SMTP via nodemailer's "gmail" service — MAIL_USER must be a full
# Gmail/Workspace address and MAIL_PASS a 16-character Google App Password
# (not the account login password; requires 2-Step Verification on the
# account).
MAIL_USER=
MAIL_PASS=

# Optional — display name shown as the email sender. Defaults to "Masar".
MAIL_FROM_NAME=Masar

# Optional — Reply-To address for outgoing mail. Defaults to MAIL_USER.
MAIL_REPLY_TO=
