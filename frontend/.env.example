# Frontend environment. Do not set NODE_ENV on Vercel: it would skip dev dependencies at install.

# Shows the demo banner, one-click demo logins, and simulated driver tracking.
NEXT_PUBLIC_DEMO_MODE=false

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API URL and origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7126/api
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:7126

# Optional
NEXT_PUBLIC_CURRENCY=EGP
